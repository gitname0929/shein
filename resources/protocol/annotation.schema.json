{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Annotation output protocol 1.3.1",
  "type": "object",
  "required": [
    "annotation_id",
    "audit_unit_id",
    "material_id",
    "page_index",
    "value",
    "status",
    "label",
    "bbox"
  ],
  "properties": {
    "annotation_id": {
      "type": "string",
      "minLength": 1
    },
    "audit_unit_id": {
      "type": "string",
      "minLength": 1
    },
    "material_id": {
      "type": "string",
      "minLength": 1
    },
    "page_index": {
      "type": "integer",
      "minimum": 1
    },
    "value": {},
    "status": {
      "enum": [
        "value",
        "unreadable",
        "invalid_value"
      ]
    },
    "label": {
      "enum": [
        "pass",
        "reject",
        "ambiguous"
      ]
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    }
  },
  "additionalProperties": false,
  "description": "Also validate exact integer type, source membership, unreadable/null consistency and coordinate ordering using contracts.py."
}
