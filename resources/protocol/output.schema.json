{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Audit output protocol 1.3.1",
  "required": [
    "audit_unit_id",
    "rule_id",
    "rule_version",
    "execution_status",
    "label",
    "applicability",
    "reason_code",
    "reason",
    "evidence",
    "artifact_version",
    "trace_id",
    "latency_ms",
    "cost_units"
  ],
  "properties": {
    "audit_unit_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "rule_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "rule_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "artifact_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "error_code": {
      "type": "string"
    },
    "execution_status": {
      "enum": [
        "completed",
        "error"
      ]
    },
    "label": {
      "enum": [
        "pass",
        "reject",
        "ambiguous",
        null
      ]
    },
    "applicability": {
      "enum": [
        "applicable",
        "not_applicable",
        "unknown",
        null
      ]
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "cost_units": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Self-reported diagnostic only. Unknown must be null; never used for official cost ranking."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "material_id",
          "page_index",
          "fact"
        ],
        "properties": {
          "material_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "page_index": {
            "type": "integer",
            "minimum": 1
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "fact": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "rule_quote": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "maxItems": 1000
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "label": {
            "enum": [
              "pass",
              "reject",
              "ambiguous"
            ]
          },
          "applicability": {
            "enum": [
              "applicable",
              "not_applicable",
              "unknown"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "label": {
            "const": null
          },
          "error_code": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "error_code"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "completed"
          },
          "applicability": {
            "const": "not_applicable"
          }
        }
      },
      "then": {
        "properties": {
          "label": {
            "const": "pass"
          },
          "reason_code": {
            "const": "rule_not_applicable"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "completed"
          },
          "applicability": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "properties": {
          "label": {
            "const": "ambiguous"
          }
        }
      }
    }
  ],
  "description": "JSON Schema plus public contracts.py semantic checks are both mandatory; source material/page membership and visual-evidence minimum require the matching input."
}
