{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Teacher feedback packet 1.3.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feedback_id",
    "base_artifact_sha256",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.3.1"
    },
    "feedback_id": {
      "type": "string",
      "minLength": 1
    },
    "base_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "packet_id",
          "audit_unit_id",
          "teacher_proposal",
          "teacher_source"
        ],
        "properties": {
          "packet_id": {
            "type": "string",
            "minLength": 1
          },
          "audit_unit_id": {
            "type": "string",
            "minLength": 1
          },
          "teacher_proposal": {
            "type": "string",
            "minLength": 1
          },
          "teacher_source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
