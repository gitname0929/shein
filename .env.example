# Environment variable NAMES used by this project (values are NOT secrets; no
# credentials are stored in the repository). Stage 01 requires none of these;
# they are reserved for later model/OCR/UI stages.

# Root override for the repo-local resource tree (defaults to <repo>/resources)
O2_AUDIT_RESOURCES_DIR=

# Writable workspace for runtime state (SQLite), defaults to <repo>/workspace
O2_AUDIT_WORKSPACE_DIR=

# Later stages: model/OCR endpoint configuration (names only)
O2_MODEL_ENDPOINT=
O2_MODEL_API_KEY=
O2_OCR_ENDPOINT=
O2_OCR_API_KEY=

# Later stages: review UI bind address
O2_UI_HOST=
O2_UI_PORT=
